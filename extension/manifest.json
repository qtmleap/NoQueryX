{
  "manifest_version": 3,
  "name": "Noquery for X",
  "version": "0.1.0",
  "description": "Xでコピーした投稿リンクからクエリパラメータを削除します。",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://mobile.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": ["copy.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
